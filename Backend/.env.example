# Copy to .env for local (non-Docker) development.
# Docker Compose sets its own values in docker-compose.yml and does not read this file.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://nuwora:nuwora@localhost:5432/nuwora?schema=public

# Secret used to sign JWT access tokens. Replace with a long random value.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed CORS origins for local development tooling.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
